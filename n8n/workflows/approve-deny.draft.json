      "id": "5bbd36c2-0260-4540-a1ca-181b32b00267",
      "name": "POST Retry Section"
    },
    {
      "parameters": {
        "jsCode": "const form = $('Decision Form').item.json;\nconst raw = $input.first().json || {};\nconst esc = (v) => String(v ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;');\n\nconst status = raw.status || raw.detail || (raw.message ? 'error' : 'unknown');\nconst summary = raw.summary || {};\nconst sections = Array.isArray(raw.sections) ? raw.sections : [];\nconst uploadId = raw.upload_id || form.upload_id;\nconst decideUrl = `http://localhost:5678/form/csv-decide?upload_id=${encodeURIComponent(uploadId || '')}`;\n\nlet meaning = 'See details below.';\nif (status === 'approved' && raw.staging_dropped) meaning = 'All sections are in production. Staging was dropped.';\nelse if (status === 'partial') meaning = 'Some sections failed. Staging was kept \u2014 retry failed section IDs.';\nelse if (status === 'denied') meaning = 'Staging and progress were dropped. Production was not changed.';\nelse if (raw.detail) meaning = typeof raw.detail === 'string' ? raw.detail : JSON.stringify(raw.detail);\n\nconst failed = sections.filter((s) => s.status === 'failed').map((s) => s.section_id);\nconst failedIds = failed.length ? failed.join(', ') : '\u2014';\n\nlet sectionsHtml = '<p><em>No section rows in this response (common after full approve cleanup or deny).</em></p>';\nif (sections.length) {\n  const rows = sections.map((s) =>\n    `<tr><td>${esc(s.section_id)}</td><td>${esc(s.status)}</td><td>${esc(s.rows_affected)}</td><td>${esc(s.attempts)}</td><td>${esc(s.last_error || '')}</td></tr>`\n  ).join('');\n  sectionsHtml = `<table><thead><tr><th>Section</th><th>Status</th><th>Rows affected</th><th>Attempts</th><th>Last error</th></tr></thead><tbody>${rows}</tbody></table>`;\n}\n\nconst html = `\n<h2>${esc(status)}</h2>\n<p>${esc(meaning)}</p>\n<table>\n  <tbody>\n    <tr><th>Upload ID</th><td>${esc(uploadId)}</td></tr>\n    <tr><th>Action</th><td>${esc(form.action)}</td></tr>\n    <tr><th>Rows upserted</th><td>${esc(raw.rows_upserted ?? '')}</td></tr>\n    <tr><th>Staging dropped</th><td>${esc(raw.staging_dropped === true ? 'yes' : raw.staging_dropped === false ? 'no' : '')}</td></tr>\n    <tr><th>Completed sections</th><td>${esc(summary.completed ?? '')}</td></tr>\n    <tr><th>Failed sections</th><td>${esc(summary.failed ?? '')}</td></tr>\n    <tr><th>Pending sections</th><td>${esc(summary.pending ?? '')}</td></tr>\n    <tr><th>Failed section IDs</th><td>${esc(failedIds)}</td></tr>\n  </tbody>\n</table>\n\n<h3>Sections</h3>\n${sectionsHtml}\n\n<hr>\n<p><a href=\"${esc(decideUrl)}\"><strong>Run another decision \u2192</strong></a></p>\n`.trim();\n\nreturn [{ json: { html, upload_id: uploadId, status: String(status), decide_url: decideUrl } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
